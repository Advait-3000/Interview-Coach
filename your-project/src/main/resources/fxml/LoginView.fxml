<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.interviewcoach.controller.LoginController"
      alignment="CENTER"
      spacing="18"
      styleClass="root"
      stylesheets="@../css/app.css"
      prefWidth="420"
      prefHeight="560"
      VBox.vgrow="ALWAYS">

    <padding>
        <Insets bottom="36" left="36" right="36" top="36"/>
    </padding>

    <Label text="Interview Coach" styleClass="label-title" textAlignment="CENTER"/>
    <Label text="Sign in to continue" styleClass="label-helper" textAlignment="CENTER"/>

    <Separator styleClass="surface" prefWidth="340" />

    <VBox alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="24" bottom="8"/>
        </padding>

        <TextField fx:id="emailField"
                   promptText="Email address"
                   styleClass="text-field"
                   prefWidth="340"
                   onAction="#handleLogin"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       styleClass="text-field"
                       prefWidth="340"
                       onAction="#handleLogin"/>

        <Label fx:id="errorLabel"
               styleClass="label-validation"
               textAlignment="CENTER"
               prefWidth="340"/>

        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="loginButton"
                    text="Sign in"
                    styleClass="primary-button"
                    prefWidth="150"
                    onAction="#handleLogin"/>
            <Button fx:id="registerButton"
                    text="Create account"
                    styleClass="secondary-button"
                    prefWidth="150"
                    onAction="#handleRegister"/>
        </HBox>

        <Label fx:id="statusLabel"
               styleClass="label-helper"
               textAlignment="CENTER"
               prefWidth="340"/>
    </VBox>
</VBox>
