<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.interviewcoach.controller.LoginController"
      alignment="CENTER"
      styleClass="root"
      stylesheets="@../css/app.css"
      prefWidth="460"
      prefHeight="640"
      VBox.vgrow="ALWAYS">

    <padding>
        <Insets top="32" right="28" bottom="32" left="28"/>
    </padding>

    <!-- Centered Login Card -->
    <VBox alignment="CENTER"
          maxWidth="410"
          styleClass="surface"
          spacing="18">
        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>

        <!-- Brand Icon & Header -->
        <VBox alignment="CENTER" spacing="10">
            <StackPane maxWidth="50" maxHeight="50" prefWidth="50" prefHeight="50"
                       style="-fx-background-color: #2458C5; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(36, 88, 197, 0.28), 10, 0, 0, 3);">
                <Label text="IC"
                       style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
            </StackPane>

            <Label text="Interview Coach"
                   styleClass="label-title"
                   textAlignment="CENTER"/>

            <Label text="Sign in to continue your preparation"
                   styleClass="label-subtitle"
                   textAlignment="CENTER"/>
        </VBox>

        <Separator prefWidth="340"/>

        <!-- Form Elements -->
        <VBox spacing="14" alignment="CENTER_LEFT" maxWidth="Infinity">
            <!-- Email Input -->
            <VBox spacing="6">
                <Label text="Email address" styleClass="label-field"/>
                <TextField fx:id="emailField"
                           promptText="name@example.com"
                           styleClass="text-field"
                           maxWidth="Infinity"
                           prefHeight="40"
                           onAction="#handleLogin"/>
            </VBox>

            <!-- Password Input -->
            <VBox spacing="6">
                <Label text="Password" styleClass="label-field"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               styleClass="password-field"
                               maxWidth="Infinity"
                               prefHeight="40"
                               onAction="#handleLogin"/>
            </VBox>

            <!-- Error Label -->
            <Label fx:id="errorLabel"
                   styleClass="label-validation"
                   textAlignment="CENTER"
                   wrapText="true"
                   alignment="CENTER"
                   maxWidth="Infinity"
                   minHeight="16"/>

            <!-- Action Buttons -->
            <VBox spacing="10" maxWidth="Infinity">
                <Button fx:id="loginButton"
                        text="Sign in"
                        styleClass="primary-button"
                        maxWidth="Infinity"
                        prefHeight="42"
                        onAction="#handleLogin"/>

                <HBox alignment="CENTER" spacing="6">
                    <padding>
                        <Insets top="4"/>
                    </padding>
                    <Label text="New student?" styleClass="label-helper-small"/>
                    <Button fx:id="registerButton"
                            text="Create account"
                            styleClass="secondary-button"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            prefHeight="36"
                            onAction="#handleRegister"/>
                </HBox>
            </VBox>

            <!-- Status Label -->
            <Label fx:id="statusLabel"
                   styleClass="label-helper-small"
                   textAlignment="CENTER"
                   alignment="CENTER"
                   maxWidth="Infinity"/>
        </VBox>
    </VBox>

</VBox>
