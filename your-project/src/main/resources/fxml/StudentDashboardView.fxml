<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.interviewcoach.controller.StudentDashboardController"
      alignment="CENTER"
      spacing="18"
      styleClass="root"
      stylesheets="@../css/app.css"
      prefWidth="900"
      prefHeight="600"
      VBox.vgrow="ALWAYS">

    <padding>
        <Insets bottom="24" left="36" right="36" top="24"/>
    </padding>

    <Label fx:id="greetingLabel" styleClass="label-title" textAlignment="CENTER"/>
    <Label fx:id="subtitleLabel" styleClass="label-helper" textAlignment="CENTER"/>

    <Separator styleClass="surface" prefWidth="780"/>

    <VBox alignment="CENTER" spacing="16" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20" bottom="10"/>
        </padding>

        <FlowPane fx:id="actionCards"
                  alignment="CENTER"
                  hgap="14"
                  vgap="14"
                  prefWidth="780"
                  maxWidth="780"/>

        <Separator styleClass="surface" prefWidth="780"/>

        <HBox alignment="CENTER" spacing="14">
            <Label fx:id="recentLabel" styleClass="label-section" prefWidth="780" textAlignment="CENTER"/>
            <Button fx:id="historyButton"
                    text="View history"
                    styleClass="secondary-button"
                    prefWidth="140"
                    onAction="#handleHistory"/>
        </HBox>

        <VBox fx:id="recentSummary"
              alignment="CENTER"
              spacing="10"
              prefWidth="780"
              maxWidth="780">
            <padding>
                <Insets top="6" bottom="6"/>
            </padding>
        </VBox>

        <VBox fx:id="emptyState"
              alignment="CENTER"
              spacing="8"
              prefWidth="780"
              visible="false"
              managed="false">
            <padding>
                <Insets top="10" bottom="10"/>
            </padding>
            <Label fx:id="emptyTitle" styleClass="label-section" textAlignment="CENTER"/>
            <Label fx:id="emptyHint" styleClass="label-helper" textAlignment="CENTER" prefWidth="520"/>
        </VBox>
    </VBox>
</VBox>
