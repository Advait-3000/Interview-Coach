<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.interviewcoach.controller.StudentDashboardController"
      alignment="TOP_CENTER"
      spacing="20"
      styleClass="root"
      stylesheets="@../css/app.css"
      VBox.vgrow="ALWAYS">

    <padding>
        <Insets top="24" right="32" bottom="32" left="32"/>
    </padding>

    <VBox spacing="20" maxWidth="960" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">

        <!-- Welcome Header Card -->
        <VBox spacing="6" styleClass="surface">
            <padding>
                <Insets top="22" right="26" bottom="22" left="26"/>
            </padding>
            <Label fx:id="greetingLabel"
                   styleClass="label-title"/>
            <Label fx:id="subtitleLabel"
                   styleClass="label-subtitle"/>
        </VBox>

        <!-- Navigation Action Cards -->
        <VBox spacing="12" styleClass="surface">
            <padding>
                <Insets top="20" right="24" bottom="22" left="24"/>
            </padding>
            <Label text="Modules &amp; Assessments"
                   styleClass="label-section"/>
            <Label text="Choose a module below to start practice questions, run mock tests, or review performance."
                   styleClass="label-helper"/>
            <FlowPane fx:id="actionCards"
                      alignment="CENTER_LEFT"
                      hgap="16"
                      vgap="16"
                      prefWrapLength="900"
                      maxWidth="Infinity">
                <padding>
                    <Insets top="6"/>
                </padding>
            </FlowPane>
        </VBox>

        <!-- Recent Activity Section -->
        <VBox spacing="14" styleClass="surface">
            <padding>
                <Insets top="20" right="24" bottom="22" left="24"/>
            </padding>

            <!-- Section Header Row -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="recentLabel"
                       text="Recent attempts"
                       styleClass="label-section"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="historyButton"
                        text="View all history"
                        styleClass="secondary-button"
                        prefWidth="135"
                        prefHeight="34"
                        onAction="#handleHistory"/>
            </HBox>

            <!-- Attempt Cards List -->
            <VBox fx:id="recentSummary"
                  spacing="10"
                  maxWidth="Infinity">
            </VBox>

            <!-- Empty State -->
            <VBox fx:id="emptyState"
                  alignment="CENTER"
                  spacing="10"
                  maxWidth="Infinity"
                  visible="false"
                  managed="false"
                  style="-fx-background-color: #F8FAFC; -fx-background-radius: 10px; -fx-border-color: #E2E8F0; -fx-border-radius: 10px; -fx-padding: 30px;">
                <Label text="📋" style="-fx-font-size: 30px;"/>
                <Label fx:id="emptyTitle"
                       styleClass="label-section"
                       textAlignment="CENTER"/>
                <Label fx:id="emptyHint"
                       styleClass="label-helper"
                       textAlignment="CENTER"
                       wrapText="true"
                       maxWidth="500"/>
            </VBox>
        </VBox>

    </VBox>
</VBox>
