<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.interviewcoach.controller.RegisterController"
      alignment="CENTER"
      spacing="14"
      styleClass="root"
      stylesheets="@../css/app.css"
      prefWidth="420"
      prefHeight="560"
      VBox.vgrow="ALWAYS">

    <padding>
        <Insets bottom="36" left="36" right="36" top="36"/>
    </padding>

    <Label text="Create account" styleClass="label-title" textAlignment="CENTER"/>
    <Label text="Register a new student account" styleClass="label-helper" textAlignment="CENTER"/>

    <Separator styleClass="surface" prefWidth="340"/>

    <VBox alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="22" bottom="8"/>
        </padding>

        <TextField fx:id="nameField"
                   promptText="Full name"
                   styleClass="text-field"
                   prefWidth="340"
                   onAction="#handleCreateAccount"/>

        <TextField fx:id="emailField"
                   promptText="Email address"
                   styleClass="text-field"
                   prefWidth="340"
                   onAction="#handleCreateAccount"/>

        <Label fx:id="nameValidation"
               styleClass="label-validation"
               textAlignment="CENTER"
               prefWidth="340"/>

        <Label fx:id="emailValidation"
               styleClass="label-validation"
               textAlignment="CENTER"
               prefWidth="340"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       styleClass="text-field"
                       prefWidth="340"
                       onAction="#handleCreateAccount"/>

        <PasswordField fx:id="confirmField"
                       promptText="Confirm password"
                       styleClass="text-field"
                       prefWidth="340"
                       onAction="#handleCreateAccount"/>

        <Label fx:id="passwordValidation"
               styleClass="label-validation"
               textAlignment="CENTER"
               prefWidth="340"/>

        <Label fx:id="errorLabel"
               styleClass="label-validation"
               textAlignment="CENTER"
               prefWidth="340"/>

        <Label fx:id="successLabel"
               styleClass="label-body"
               textAlignment="CENTER"
               prefWidth="340"
               style="-fx-text-fill: #1E7F4F;"/>

        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="createButton"
                    text="Create account"
                    styleClass="primary-button"
                    prefWidth="150"
                    onAction="#handleCreateAccount"/>
            <Button fx:id="backButton"
                    text="Back to sign in"
                    styleClass="secondary-button"
                    prefWidth="150"
                    onAction="#handleBack"/>
        </HBox>
    </VBox>
</VBox>
